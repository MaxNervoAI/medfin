# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Resend (emails)
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=Dr Wallet <alertas@drwallet.cl>

# App
NEXT_PUBLIC_APP_URL=https://drwallet.cl
NEXT_PUBLIC_DEFAULT_TAX_RATE=0.145

# Local development - use JSON file-based DB instead of Supabase
# Set to 'true' to use local JSON files for data storage (no Docker needed)
NEXT_PUBLIC_USE_JSON_DB=false

# Cron (para alertas automáticas)
CRON_SECRET=un-secreto-largo-y-seguro

# ---------------------------------------------------------------
# Acceso rápido en desarrollo (NUNCA definir en producción)
# ---------------------------------------------------------------
# Muestra el botón "Entrar como usuario de prueba" en /login e inicia una
# sesión REAL de Supabase con ese usuario (RLS se aplica igual que en prod).
# Solo funciona con `next dev`: en un build de producción NODE_ENV es
# 'production' y la ruta /api/dev-login responde 404.
# Crea el usuario con: node scripts/create-dev-user.mjs
DEV_LOGIN_ENABLED=false
DEV_LOGIN_EMAIL=dev@drwallet.local
DEV_LOGIN_PASSWORD=cambia-esta-clave
